---
// Full-screen gate below the `sm` breakpoint — the plaque tooling wants a
// pointer and horizontal room, so phones get the message instead of the app.
// Pure CSS (sm:hidden), static HTML outside the React island.
---

<div
  id="mobile-notice"
  role="note"
  class="sm:hidden fixed inset-0 z-[250] bg-background flex flex-col items-center justify-center gap-6 px-8 text-center"
>
  <div
    class="text-[13px] tracking-[0.3em] uppercase text-foreground/40"
    style="font-family: var(--font-display)"
  >
    astrolabe
  </div>
  <h2
    class="font-bold uppercase tracking-[0.18em] text-[18px] leading-snug text-foreground"
    style="font-family: var(--font-display)"
  >
    best experienced on a bigger screen
  </h2>
  <p class="text-[11px] leading-relaxed text-foreground/60 max-w-[34ch]">
    this is a desktop instrument — open it on a laptop or monitor for the full plaque,
    tooltips and keyboard shortcuts.
  </p>
</div>
