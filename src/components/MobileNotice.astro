---
// Mobile-only notice — the plaque tooling wants a pointer and horizontal
// room. Static HTML outside the React island so it shows pre-hydration;
// dismissal is remembered for the session (per tab).
---

<div
  id="mobile-notice"
  role="note"
  class="sm:hidden hidden fixed inset-x-0 bottom-0 z-[90] border-t border-foreground/20 bg-background/95 backdrop-blur px-4 pt-3 pb-[max(12px,env(safe-area-inset-bottom))]"
>
  <div class="flex items-start justify-between gap-3">
    <p class="text-[11px] leading-relaxed text-foreground">
      <strong
        class="block font-bold uppercase tracking-[0.15em] text-[12px]"
        style="font-family: var(--font-display)"
      >
        best experienced on a bigger screen
      </strong>
      <span class="block text-foreground/60 mt-1">
        astrolabe is built for desktop — the plaque, tooltips and keyboard shortcuts need the
        room.
      </span>
    </p>
    <button
      id="mobile-notice-dismiss"
      type="button"
      aria-label="dismiss notice"
      class="shrink-0 border border-foreground/30 text-foreground/70 hover:text-foreground px-2 py-1 text-[12px] leading-none transition"
    >
      ×
    </button>
  </div>
</div>

<script is:inline>
  ;(() => {
    const KEY = "astrolabe-mobile-notice"
    const el = document.getElementById("mobile-notice")
    if (!el) return
    let dismissed = false
    try {
      dismissed = sessionStorage.getItem(KEY) === "1"
    } catch {
      // storage may be disabled — show the notice anyway
    }
    if (!dismissed) el.classList.remove("hidden")
    document.getElementById("mobile-notice-dismiss")?.addEventListener("click", () => {
      el.classList.add("hidden")
      try {
        sessionStorage.setItem(KEY, "1")
      } catch {
        // ignore
      }
    })
  })()
</script>
